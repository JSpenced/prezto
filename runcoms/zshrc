# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

expand-or-complete-with-dots() {      # This bunch of code displays red dots when autocompleting
  echo -n "\e[31m......\e[0m"         # a command with the tab key, "Oh-my-zsh"-style.
  zle expand-or-complete
  zle redisplay
}
zle -N expand-or-complete-with-dots
bindkey "^I" expand-or-complete-with-dots

#function f() { find . -iname "*$1*" ${@:2} }
#function r() { grep "$1" ${@:2} -R . }

setopt extended_glob
setopt ksh_glob

# Source private.
if [[ -s "${HOME}/.zprivate" ]]; then
  source "${HOME}/.zprivate"
fi

if [[ -s "${HOME}/.zaliases" ]]; then
  source "${HOME}/.zaliases"
fi

# Try to setup to expand aliases
expand-aliases() {
  unset 'functions[_expand-aliases]'
  functions[_expand-aliases]=$BUFFER
  (($+functions[_expand-aliases])) &&
	BUFFER=${functions[_expand-aliases]#$'\t'} &&
	CURSOR=$#BUFFER
}
zle -N expand-aliases
bindkey '\e^E' expand-aliases

# Treat these characters as part of a word.
WORDCHARS='*?[]~&;!#$%^(){}<>'

# Setup fzf command
# Don't need the first line when using fzf module
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='rg --files --hidden'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_COMPLETION_TRIGGER='~~'

# Setup basic paths
export PATH=${HOME}/bin:$PATH
export LD_LIBRARY_PATH=${HOME}/lib:$LD_LIBRARY_PATH

# Mac config

export VSCODE=code
# export EDITOR=$VSCODE' -w'
export EDITOR='emacsclient --create-frame --alternate-editor="subl -w"'
export VISUAL=$EDITOR

export PATH=$PATH:$HOME/Dropbox/Programs/system-scripts
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# First check if iterm terminal and run shell integration if so
${HOME}/.iterm2/it2check && test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

autoload -U +X bashcompinit && bashcompinit
if [[ -s "/usr/local/bin/terraform" ]]; then
  complete -o nospace -C /usr/local/bin/terraform terraform
fi

if [[ -s "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc" ]]; then
  source "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"
fi
if [[ -s "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc" ]]; then
  source "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"
fi
if [[ -s "${HOME}/.config/broot/launcher/bash/br" ]]; then
  source "${HOME}/.config/broot/launcher/bash/br"
fi
if [[ -s '/usr/local/bin/aws_completer' ]]; then
  complete -C '/usr/local/bin/aws_completer' aws
fi
source <(kubectl completion zsh)



if [[ -s "${HOME}/anaconda3/bin/conda" ]]; then
  # >>> conda initialize >>>
  # !! Contents within this block are managed by 'conda init' !!
  __conda_setup="$('${HOME}/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
	  eval "$__conda_setup"
  else
	  if [ -f "${HOME}/anaconda3/etc/profile.d/conda.sh" ]; then
		  . "${HOME}/anaconda3/etc/profile.d/conda.sh"
	  else
		  export PATH="${HOME}/anaconda3/bin:$PATH"
	  fi
  fi
  unset __conda_setup
  # <<< conda initialize <<<
fi

